# ============================================================
# Agentic Historian – Environment Configuration
# Copy to .env and fill in your values
# ============================================================

# --- Discord ---
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_guild_id_here          # optional: restrict to one server
DISCORD_CHANNEL_HISTORIAN=historian-general  # default channel name for outputs

# --- Anthropic / Claude ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-opus-4-5                 # or claude-sonnet-4-5 for faster/cheaper
CLAUDE_VISION_MODEL=claude-opus-4-5          # for visual layout analysis (Agent B/D)

# --- HuggingFace ---
HF_TOKEN=your_huggingface_token_here
HF_REPO_ID=your_org/agentic-historian-corpus # dataset repo for transcriptions/outputs

# --- GitHub (Corpus storage for Voyant) ---
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=your_org/agentic-historian-corpus

# --- Local Paths ---
DATA_DIR=./data
HOT_FOLDER=./data/hot_folder                 # drop images/PDFs here → auto-processed
OUTPUT_DIR=./data/outputs
CORPUS_DIR=./data/corpus
TRANSCRIPTION_DIR=./data/transcriptions
DESCRIPTION_DIR=./data/descriptions
KNOWLEDGE_HUB_DIR=./knowledge_hub/data
TMP_DIR=./data/tmp

# --- Voyant Tools ---
VOYANT_URL=https://voyant-tools.org          # or your self-hosted instance

# --- Agent Settings ---
HTR_QUALITY_THRESHOLD=0.75                   # min confidence to accept HTR output
MAX_RETRIES=3                                # retries if HTR quality too low
AGENT_LOG_TOKENS=true                        # log token usage per agent run

# --- Feature Flags ---
ENABLE_HOT_FOLDER_WATCH=true
ENABLE_HF_UPLOAD=true
ENABLE_GITHUB_PUSH=false
